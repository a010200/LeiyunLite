{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "v1.3.2: Build",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\Tools\\Build-VSCode.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "v1.3.2: Safe preview",
      "type": "process",
      "command": "${workspaceFolder}\\bin\\VSCode1.3.2\\LeiyunLite.Desktop.exe",
      "args": ["--demo"],
      "dependsOn": "v1.3.2: Build",
      "problemMatcher": []
    },
    {
      "label": "v1.3.2: Desktop tests (opens test windows)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build-desktop.ps1", "-Test", "-OutputDirectory", "bin\\VSCodeTests1.3.2"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile"
    }
  ]
}
